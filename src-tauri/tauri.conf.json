{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Datum Sim",
  "identifier": "com.edgarmendonca.datumsim",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Datum Sim",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Datum",
    "copyright": "© 2026 Edgar Mendonca",
    "category": "Productivity",
    "shortDescription": "Model and simulate dynamic systems",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "dsim"
        ],
        "name": "Datum Sim model",
        "description": "Datum Sim model",
        "role": "Editor"
      }
    ],
    "resources": {
      "../py/worker.py": "py/worker.py",
      "../py/datum_sim/*.py": "py/datum_sim/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
